{
 "duration": 48.5,
 "captions": [
  {
   "text": "Everyone!",
   "start": 0,
   "end": 0.333,
   "style": ""
  },
  {
   "text": "I'm Rogie Domin,",
   "start": 0.333,
   "end": 1.573,
   "style": ""
  },
  {
   "text": "and today,",
   "start": 1.573,
   "end": 2.106,
   "style": ""
  },
  {
   "text": "let's talk about",
   "start": 2.106,
   "end": 3.213,
   "style": ""
  },
  {
   "text": "Bill of Rights",
   "start": 3.213,
   "end": 3.973,
   "style": "red"
  },
  {
   "text": "Section 7,",
   "start": 3.973,
   "end": 4.773,
   "style": "red"
  },
  {
   "text": "or the Right to",
   "start": 4.773,
   "end": 5.333,
   "style": ""
  },
  {
   "text": "Information.",
   "start": 5.333,
   "end": 6.2,
   "style": "red"
  },
  {
   "text": "So basically,",
   "start": 6.2,
   "end": 7.04,
   "style": ""
  },
  {
   "text": "this means that",
   "start": 7.04,
   "end": 7.76,
   "style": ""
  },
  {
   "text": "every Filipino citizen",
   "start": 7.76,
   "end": 9.04,
   "style": ""
  },
  {
   "text": "has the right",
   "start": 9.04,
   "end": 9.52,
   "style": ""
  },
  {
   "text": "to know",
   "start": 9.52,
   "end": 9.96,
   "style": "red"
  },
  {
   "text": "what our government",
   "start": 9.96,
   "end": 11.0,
   "style": ""
  },
  {
   "text": "is doing,",
   "start": 11.0,
   "end": 11.76,
   "style": ""
  },
  {
   "text": "especially",
   "start": 11.76,
   "end": 12.52,
   "style": ""
  },
  {
   "text": "when it involves",
   "start": 12.52,
   "end": 13.44,
   "style": ""
  },
  {
   "text": "public money.",
   "start": 13.44,
   "end": 14.4,
   "style": "red"
  },
  {
   "text": "For example,",
   "start": 14.4,
   "end": 15.422,
   "style": ""
  },
  {
   "text": "let's say na",
   "start": 15.422,
   "end": 16.03,
   "style": ""
  },
  {
   "text": "atong gobyerno",
   "start": 16.03,
   "end": 16.606,
   "style": ""
  },
  {
   "text": "nag-allocate ug",
   "start": 16.606,
   "end": 17.262,
   "style": ""
  },
  {
   "text": "10 million pesos",
   "start": 17.262,
   "end": 18.142,
   "style": "red"
  },
  {
   "text": "para sa",
   "start": 18.142,
   "end": 18.582,
   "style": ""
  },
  {
   "text": "construction sa road.",
   "start": 18.582,
   "end": 19.429,
   "style": ""
  },
  {
   "text": "Of course,",
   "start": 19.429,
   "end": 20.229,
   "style": ""
  },
  {
   "text": "we have the",
   "start": 20.229,
   "end": 20.709,
   "style": ""
  },
  {
   "text": "right to ask",
   "start": 20.709,
   "end": 21.269,
   "style": "red"
  },
  {
   "text": "kung asa padulong",
   "start": 21.269,
   "end": 22.149,
   "style": ""
  },
  {
   "text": "ang kwarta,",
   "start": 22.149,
   "end": 22.736,
   "style": ""
  },
  {
   "text": "giunsa ni siya paggasto,",
   "start": 22.736,
   "end": 24.069,
   "style": ""
  },
  {
   "text": "and whether",
   "start": 24.069,
   "end": 24.589,
   "style": ""
  },
  {
   "text": "the project",
   "start": 24.589,
   "end": 25.069,
   "style": ""
  },
  {
   "text": "is actually",
   "start": 25.069,
   "end": 25.669,
   "style": ""
  },
  {
   "text": "being completed.",
   "start": 25.669,
   "end": 26.566,
   "style": "red"
  },
  {
   "text": "But remember,",
   "start": 26.566,
   "end": 27.516,
   "style": ""
  },
  {
   "text": "this right has",
   "start": 27.516,
   "end": 28.33,
   "style": ""
  },
  {
   "text": "limitations",
   "start": 28.33,
   "end": 28.876,
   "style": "red"
  },
  {
   "text": "because some",
   "start": 28.876,
   "end": 29.436,
   "style": ""
  },
  {
   "text": "government information",
   "start": 29.436,
   "end": 30.476,
   "style": ""
  },
  {
   "text": "is confidential",
   "start": 30.476,
   "end": 31.316,
   "style": "red"
  },
  {
   "text": "and protected",
   "start": 31.316,
   "end": 31.956,
   "style": ""
  },
  {
   "text": "by law.",
   "start": 31.956,
   "end": 32.756,
   "style": "red"
  },
  {
   "text": "So, why",
   "start": 32.756,
   "end": 33.236,
   "style": ""
  },
  {
   "text": "is this important?",
   "start": 33.236,
   "end": 34.287,
   "style": ""
  },
  {
   "text": "Well,",
   "start": 34.287,
   "end": 34.84,
   "style": ""
  },
  {
   "text": "it promotes",
   "start": 34.84,
   "end": 35.48,
   "style": ""
  },
  {
   "text": "transparency,",
   "start": 35.48,
   "end": 36.6,
   "style": "red"
  },
  {
   "text": "accountability,",
   "start": 36.6,
   "end": 37.56,
   "style": "red"
  },
  {
   "text": "and helps prevent",
   "start": 37.56,
   "end": 38.44,
   "style": ""
  },
  {
   "text": "corruption.",
   "start": 38.44,
   "end": 39.32,
   "style": "red"
  },
  {
   "text": "At the end of the day,",
   "start": 39.32,
   "end": 40.867,
   "style": ""
  },
  {
   "text": "the government serves",
   "start": 40.88,
   "end": 41.92,
   "style": ""
  },
  {
   "text": "the people,",
   "start": 41.92,
   "end": 42.48,
   "style": ""
  },
  {
   "text": "and we have",
   "start": 42.48,
   "end": 42.92,
   "style": ""
  },
  {
   "text": "the right to know",
   "start": 42.92,
   "end": 43.68,
   "style": "red"
  },
  {
   "text": "how it operates.",
   "start": 43.68,
   "end": 44.873,
   "style": ""
  },
  {
   "text": "Thank you!",
   "start": 44.873,
   "end": 45.5,
   "style": ""
  }
 ],
